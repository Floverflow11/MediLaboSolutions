{
  "Routes": [
    {
      "UpstreamPathTemplate": "/api/patients",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "DownstreamPathTemplate": "/patients",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5256
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "BasicAuth",
        "AllowedScopes": []
      }
    },
    {
      "UpstreamPathTemplate": "/api/patients/{id}",
      "UpstreamHttpMethod": [ "GET", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/patients/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5256
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "BasicAuth",
        "AllowedScopes": []
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5136"
  }
}