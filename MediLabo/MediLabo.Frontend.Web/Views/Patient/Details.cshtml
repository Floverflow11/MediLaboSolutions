@model PatientDetailsViewModel

@{
    ViewData["Title"] = $"Patient {Model.Patient.Id}";
}

<div class="container">
    <h2>Patient</h2>
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Id</th>
            <th>FirstName</th>
            <th>LastName</th>
            <th>DateOfBirth</th>
            <th>Gender</th>
            <th>Address</th>
            <th>PhoneNumber</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        <tr>
            <td>@Model.Patient.Id</td>
            <td>@Model.Patient.FirstName</td>
            <td>@Model.Patient.LastName</td>
            <td>@Model.Patient.DateOfBirth</td>
            <td>@Model.Patient.Gender</td>
            <td>@Model.Patient.Address</td>
            <td>@Model.Patient.PhoneNumber</td>
            <td><a asp-controller="Patient" asp-action="Edit" asp-route-id="@Model.Patient.Id">Edit</a></td>
        </tr>
        </tbody>
    </table>

    <h2>Notes</h2>
    <p><a asp-controller="Patient" asp-action="AddNote" asp-route-id="@Model.Patient.Id">Add</a></p>
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Content</th>
            <th>CreatedAt</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var note in Model.Notes)
        {
            <tr>
                <td>@note.Content</td>
                <td>@note.CreatedAt</td>
            </tr>
        }
        </tbody>
    </table>
</div>
